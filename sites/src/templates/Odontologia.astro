---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Comparador from '../components/Comparador.astro';
import {
  type ClienteOdontologia,
  imagem,
  linkWhatsapp,
  linkAvaliacoesGoogle,
  formatarNota,
  DIAS,
  DIAS_SCHEMA,
} from '../lib/clientes';

interface Props {
  cliente: ClienteOdontologia;
}
const { cliente: c } = Astro.props;

const whatsapp = linkWhatsapp(c);
const endereco = c.endereco;
const enderecoCurto = `${endereco.rua}, ${endereco.bairro}`;
const nota = formatarNota(c.google.nota);
const heroImg = imagem(c, c.hero.imagem);
const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });

const estiloTema = [
  c.tema?.grafite && `--grafite: ${c.tema.grafite}`,
  c.tema?.acento && `--acento: ${c.tema.acento}`,
  c.tema?.acentoTexto && `--acento-texto: ${c.tema.acentoTexto}`,
]
  .filter(Boolean)
  .join('; ');

// Horário: segunda a domingo, com dias sem atendimento marcados como fechado.
const ordemDias = [1, 2, 3, 4, 5, 6, 0];
const horarioSemana = ordemDias.map((dia) => ({ dia, h: c.horario.find((x) => x.dia === dia) }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: c.nome,
  description: c.descricao,
  url: new URL(`/${c.slug}`, Astro.site).toString(),
  image: new URL(og.src, Astro.site).toString(),
  telephone: c.contato.telefone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: endereco.rua,
    addressLocality: endereco.cidade,
    addressRegion: endereco.uf,
    postalCode: endereco.cep,
    addressCountry: 'BR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: endereco.lat, longitude: endereco.lng },
  hasMap: endereco.mapsUrl,
  areaServed: { '@type': 'City', name: endereco.cidade },
  openingHoursSpecification: c.horario.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${DIAS_SCHEMA[h.dia]}`,
    opens: h.abre,
    closes: h.fecha,
  })),
  availableService: c.tratamentos.flatMap((g) =>
    g.itens.map((i) => ({ '@type': 'MedicalProcedure', name: i.nome })),
  ),
  sameAs: c.contato.instagram ? [`https://www.instagram.com/${c.contato.instagram}/`] : undefined,
};
---

<Base
  titulo={`${c.nome} | Dentista no ${endereco.bairro}, ${endereco.cidade}`}
  descricao={c.descricao}
  noindex={c.demo}
  imagemOg={og.src}
  estiloTema={estiloTema}
  schema={schema}
>
  <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-marmore focus:px-4 focus:py-2">
    Pular para o conteúdo
  </a>

  <!-- Topo -->
  <header class="bg-grafite text-marmore">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
      <a href={`/${c.slug}`} class="-my-2 flex items-baseline gap-3 py-3 leading-none">
        <span class="font-display text-[1.75rem] font-medium tracking-tight text-acento">{c.nome.split(' ')[0]}</span>
        <span class="text-sm text-pedra-escura">{c.complemento ?? c.nome}</span>
      </a>
      <a href={whatsapp} class="btn btn-whatsapp hidden min-h-11 py-2 text-[0.9375rem] sm:inline-flex">
        <Icone nome="whatsapp" class="size-5" />
        Agendar avaliação
      </a>
    </div>
  </header>

  <main id="conteudo">
    <!-- Hero -->
    <section class="bg-grafite text-marmore">
      <div class="mx-auto grid max-w-6xl gap-7 px-5 pb-12 pt-5 sm:gap-10 sm:px-8 sm:pb-14 sm:pt-6 md:grid-cols-[1.1fr_0.9fr] md:items-end md:gap-14 md:pb-20 md:pt-10">
        <div class="order-2 md:order-1 md:pb-6">
          <h1 class="font-display text-[clamp(2.125rem,0.9rem+5.4vw,2.75rem)] font-medium leading-[1.04] tracking-[-0.015em] text-balance sm:text-6xl md:text-5xl lg:text-[4.5rem]">
            {c.hero.titulo}
          </h1>
          <p class="mt-5 max-w-[34rem] text-pedra sm:mt-6 sm:text-lg">{c.hero.subtitulo}</p>

          <a href={linkAvaliacoesGoogle(c)} class="mt-4 inline-flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1 text-pedra hover:text-marmore sm:mt-6">
            <span class="flex text-acento" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <Icone nome="estrela" class="size-[1.1rem]" />)}
            </span>
            <span><strong class="font-semibold text-marmore">{nota}</strong> no Google, {c.google.avaliacoes} avaliações</span>
          </a>

          <div class="mt-5 flex flex-col gap-3 sm:mt-8 sm:flex-row md:flex-col md:items-start xl:flex-row">
            <a href={whatsapp} class="btn btn-whatsapp hero-cta text-base">
              <Icone nome="whatsapp" class="size-5" />
              <!-- Abaixo de 375px o rótulo longo quebraria em duas linhas; o ícone já diz "WhatsApp". -->
              <span>Agendar avaliação<span class="hidden min-[375px]:inline"> pelo WhatsApp</span></span>
            </a>
            <a href="#onde" class="btn btn-contorno text-base text-pedra hover:text-marmore">Ver endereço e horário</a>
          </div>
        </div>

        <div class="order-1 md:order-2">
          <Image
            src={heroImg}
            alt={c.hero.imagemAlt}
            widths={[400, 600, 804]}
            quality={68}
            sizes="(min-width: 768px) 42vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[5/4] max-h-[34rem] w-full rounded-t-[999px] rounded-b-[1.25rem] object-cover object-[50%_30%] sm:aspect-[3/2] md:aspect-[4/5] md:max-h-none md:object-center"
          />
        </div>
      </div>
    </section>

    <!-- Antes e depois -->
    {c.antesDepois && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="antes-depois">
        <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-center md:gap-14">
          <div>
            <h2 id="antes-depois" class="titulo-secao">{c.antesDepois.titulo}</h2>
            <p class="mt-4 max-w-md text-tinta-suave">{c.antesDepois.texto}</p>
            <a href={whatsapp} class="mt-4 inline-flex min-h-11 items-center font-semibold text-acento-texto underline decoration-1 underline-offset-4 hover:decoration-2">
              Quero uma simulação do meu sorriso
            </a>
          </div>
          <Comparador
            antes={imagem(c, c.antesDepois.destaque.antes)}
            depois={imagem(c, c.antesDepois.destaque.depois)}
            legenda={c.antesDepois.destaque.legenda}
            sizes="(min-width: 768px) 640px, 100vw"
          />
        </div>

        {c.antesDepois.outros && (
          <div class="mt-12 grid gap-8 sm:grid-cols-2">
            {c.antesDepois.outros.map((caso) => (
              <figure>
                <div class="grid grid-cols-2 gap-1.5 overflow-hidden rounded-[1.25rem]">
                  <div class="relative">
                    <Image src={imagem(c, caso.antes)} widths={[300, 460]} quality={68} sizes="(min-width: 640px) 25vw, 50vw" alt={`${caso.legenda}: antes`} class="aspect-[3/4] h-full w-full object-cover" />
                    <span class="absolute left-2 top-2 rounded-full bg-tinta/70 px-2.5 py-0.5 text-sm font-semibold text-white">Antes</span>
                  </div>
                  <div class="relative">
                    <Image src={imagem(c, caso.depois)} widths={[300, 460]} quality={68} sizes="(min-width: 640px) 25vw, 50vw" alt={`${caso.legenda}: depois`} class="aspect-[3/4] h-full w-full object-cover" />
                    <span class="absolute left-2 top-2 rounded-full bg-tinta/70 px-2.5 py-0.5 text-sm font-semibold text-white">Depois</span>
                  </div>
                </div>
                <figcaption class="mt-3 text-sm text-tinta-suave">{caso.legenda}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- Tratamentos -->
    <section class="bg-pedra" aria-labelledby="tratamentos">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24">
        <h2 id="tratamentos" class="titulo-secao max-w-2xl">Tratamentos</h2>
        <div class="mt-10 grid gap-x-14 gap-y-12 md:grid-cols-2">
          {c.tratamentos.map((grupo) => (
            <div>
              <h3 class="border-b border-pedra-escura pb-3 font-display text-2xl font-medium">{grupo.grupo}</h3>
              <dl class="divide-y divide-pedra-escura/70">
                {grupo.itens.map((item) => (
                  <div class="py-4">
                    <dt class="font-semibold">{item.nome}</dt>
                    <dd class="mt-1 text-tinta-suave">{item.texto}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Primeira consulta -->
    {c.primeiraConsulta && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="primeira-consulta">
        <h2 id="primeira-consulta" class="titulo-secao max-w-2xl">{c.primeiraConsulta.titulo}</h2>
        <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {c.primeiraConsulta.passos.map((passo, i) => (
            <li class="border-t border-tinta/15 pt-5">
              <span class="font-display text-4xl font-medium text-acento-texto" aria-hidden="true">{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold">{passo.titulo}</h3>
              <p class="mt-2 text-tinta-suave">{passo.texto}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Avaliações -->
    <section class="bg-grafite text-marmore" aria-labelledby="avaliacoes">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 id="avaliacoes" class="titulo-secao">O que dizem os pacientes</h2>
            <p class="mt-4 text-pedra">
              {c.google.cincoEstrelas
                ? `${c.google.cincoEstrelas} das ${c.google.avaliacoes} avaliações no Google são de 5 estrelas.`
                : `Nota ${nota} com ${c.google.avaliacoes} avaliações no Google.`}
            </p>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-display text-6xl font-medium leading-none text-acento">{nota}</span>
            <span class="flex text-acento" role="img" aria-label={`Nota ${nota} de 5`}>
              {[0, 1, 2, 3, 4].map(() => <Icone nome="estrela" class="size-5" />)}
            </span>
          </div>
        </div>

        <p class="mt-8 text-sm text-pedra-escura md:hidden">Deslize para o lado para ler mais avaliações.</p>
        <ul class="avaliacoes-lista -mx-5 mt-4 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pb-4 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:mt-10 md:grid md:grid-cols-2 md:gap-6 lg:grid-cols-3 md:overflow-visible md:px-0 md:pb-0" role="list" tabindex="0" aria-label="Avaliações de pacientes no Google">
          {c.avaliacoes.map((av) => (
            <li class="w-[85%] shrink-0 snap-start rounded-[1.25rem] bg-white/[0.06] p-6 sm:w-[60%] md:w-auto">
              <blockquote>
                <p class="text-pedra">“{av.texto}”</p>
                <footer class="mt-5 text-sm">
                  <span class="font-semibold text-marmore">{av.autor}</span>
                  <span class="text-pedra-escura">, no Google em {av.quando}</span>
                </footer>
              </blockquote>
            </li>
          ))}
        </ul>

        <a href={linkAvaliacoesGoogle(c)} class="btn btn-contorno mt-8 text-pedra hover:text-marmore">
          Ler todas as {c.google.avaliacoes} avaliações no Google
        </a>
      </div>
    </section>

    <!-- Espaço -->
    {c.espaco && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="espaco">
        <div class="max-w-2xl">
          <h2 id="espaco" class="titulo-secao">{c.espaco.titulo}</h2>
          <p class="mt-4 text-tinta-suave">{c.espaco.texto}</p>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2 md:gap-4">
          {c.espaco.fotos.map((foto, i) => (
            <Image
              src={imagem(c, foto.src)}
              alt={foto.alt}
              widths={[400, 700, 1000]}
              quality={68}
              sizes={i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
              class:list={[
                'h-full w-full rounded-[1rem] object-cover',
                i === 0 && 'col-span-2 aspect-[4/3] md:row-span-2 md:aspect-auto',
                (i === 1 || i === 2) && 'aspect-square',
                i >= 3 && 'col-span-2 aspect-[2/1]',
              ]}
            />
          ))}
        </div>
        {c.espaco.acessibilidade && (
          <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-tinta-suave" role="list">
            {c.espaco.acessibilidade.map((item) => (
              <li class="flex items-start gap-2"><Icone nome="acessivel" class="mt-[0.2rem] size-5 shrink-0 text-acento-texto" />{item}</li>
            ))}
          </ul>
        )}
      </section>
    )}

    <!-- Onde estamos -->
    <section id="onde" class="bg-pedra" aria-labelledby="onde-titulo">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-2 md:gap-14 md:py-24">
        <div>
          <h2 id="onde-titulo" class="titulo-secao">Onde estamos</h2>
          <address class="mt-6 flex gap-3 not-italic">
            <Icone nome="pino" class="mt-1 size-5 shrink-0 text-acento-texto" />
            <span>
              {endereco.rua}<br />
              {endereco.bairro}, {endereco.cidade} - {endereco.uf}<br />
              CEP {endereco.cep}
            </span>
          </address>

          <h3 class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold">
            <Icone nome="relogio" class="size-5 text-acento-texto" />
            Horário de atendimento
            <span id="status-aberto" class="whitespace-nowrap rounded-full px-2.5 py-0.5 text-sm font-semibold" hidden></span>
          </h3>
          <table class="mt-4 w-full max-w-sm text-left">
            <caption class="sr-only">Horário de atendimento por dia da semana</caption>
            <tbody>
              {horarioSemana.map(({ dia, h }) => (
                <tr class="border-b border-pedra-escura/70" data-dia={dia}>
                  <th scope="row" class="py-2.5 font-normal">{DIAS[dia]}</th>
                  <td class="py-2.5 text-right tabular-nums">{h ? `${h.abre} às ${h.fecha}` : 'Fechado'}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={whatsapp} class="btn btn-whatsapp"><Icone nome="whatsapp" class="size-5" />Agendar pelo WhatsApp</a>
            <a href={endereco.mapsUrl} class="btn btn-contorno text-tinta">Abrir no Google Maps</a>
          </div>
        </div>

        <div class="mapa relative min-h-[20rem] overflow-hidden rounded-[1.25rem] bg-grafite text-marmore md:min-h-full" data-lat={endereco.lat} data-lng={endereco.lng}>
          <div class="mapa-capa absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center">
            <Icone nome="pino" class="size-10 text-acento" />
            <p class="max-w-xs text-pedra">{endereco.rua}, no {endereco.bairro}, {endereco.cidade}.</p>
            <button type="button" class="mapa-botao btn btn-contorno min-h-11 cursor-pointer text-pedra hover:text-marmore">Mostrar mapa aqui</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-grafite pb-[calc(6.5rem+env(safe-area-inset-bottom))] text-pedra-escura sm:pb-28">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 pt-12 sm:px-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="font-display text-2xl text-acento">{c.nome}</p>
        <p class="mt-2 text-sm">{enderecoCurto}, {endereco.cidade} - {endereco.uf}</p>
      </div>
      <ul class="-my-1 flex flex-col gap-1" role="list">
        <li><a href={whatsapp} class="inline-flex min-h-11 items-center gap-2.5 hover:text-marmore"><Icone nome="whatsapp" class="size-5" />{c.contato.telefone.replace('+55 ', '')}</a></li>
        {c.contato.instagram && (
          <li><a href={`https://www.instagram.com/${c.contato.instagram}/`} class="inline-flex min-h-11 items-center gap-2.5 hover:text-marmore"><Icone nome="instagram" class="size-5" />@{c.contato.instagram}</a></li>
        )}
      </ul>
    </div>
    {c.demo && (
      <p class="mx-auto mt-10 max-w-6xl px-5 text-[0.8125rem] leading-relaxed text-pedra-escura/80 sm:px-8">
        Prévia de site criada para {c.nome}. Fotos, avaliações e informações públicas do Google e do Instagram da clínica.
      </p>
    )}
  </footer>

  <!--
    WhatsApp fixo. Só aparece depois que o CTA do hero sai da tela (evita CTA duplicado no primeiro viewport).
    Celular: barra inferior de largura total. Não cobre o canto do texto como o botão flutuante cobria,
    e o rótulo explícito ("Agendar pelo WhatsApp") converte melhor que só "WhatsApp".
    sm+: botão flutuante no canto inferior direito.
  -->
  <div
    id="whatsapp-fixo"
    data-oculto
    class="whatsapp-fixo fixed inset-x-0 bottom-0 z-40 border-t border-tinta/10 bg-marmore/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm sm:inset-x-auto sm:bottom-6 sm:right-6 sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
  >
    <a
      href={whatsapp}
      class="btn btn-whatsapp min-h-12 w-full text-base sm:min-h-14 sm:w-auto sm:px-5 sm:shadow-[0_8px_24px_rgb(0_0_0/0.25)]"
    >
      <Icone nome="whatsapp" class="size-6" />
      <span class="sm:hidden">Agendar pelo WhatsApp</span>
      <span class="hidden sm:inline">WhatsApp</span>
    </a>
  </div>
</Base>

<script>
  // Destaca o dia de hoje e mostra se está aberto agora (horário de Brasília).
  const agora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
  const linha = document.querySelector<HTMLTableRowElement>(`tr[data-dia="${agora.getDay()}"]`);
  if (linha) {
    linha.classList.add('font-semibold');
    const horas = linha.querySelector('td')?.textContent ?? '';
    const m = horas.match(/(\d\d):(\d\d) às (\d\d):(\d\d)/);
    const status = document.getElementById('status-aberto');
    if (status) {
      const min = agora.getHours() * 60 + agora.getMinutes();
      const aberto = !!m && min >= +m[1] * 60 + +m[2] && min < +m[3] * 60 + +m[4];
      status.textContent = aberto ? 'Aberto agora' : 'Fechado agora';
      status.className += aberto ? ' bg-whatsapp/15 text-whatsapp' : ' bg-tinta/10 text-tinta-suave';
      status.hidden = false;
    }
  }

  // WhatsApp fixo aparece quando o CTA do hero já ficou para trás (acima da tela).
  // Usa scroll em vez de IntersectionObserver: um salto direto (âncora, voltar ao topo) passa o CTA
  // de "acima" para "abaixo" da tela sem cruzar o viewport e o observer não dispararia.
  const fixo = document.getElementById('whatsapp-fixo');
  const heroCta = document.querySelector('.hero-cta');
  if (fixo && heroCta) {
    let agendado = false;
    const atualizar = () => {
      agendado = false;
      fixo.toggleAttribute('data-oculto', heroCta.getBoundingClientRect().bottom > 0);
    };
    const pedir = () => {
      if (!agendado) { agendado = true; requestAnimationFrame(atualizar); }
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir, { passive: true });
    atualizar();
  } else {
    fixo?.removeAttribute('data-oculto');
  }

  // Mapa só carrega quando a pessoa pede (mantém a página leve).
  document.querySelector('.mapa-botao')?.addEventListener('click', () => {
    const mapa = document.querySelector<HTMLElement>('.mapa');
    if (!mapa) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.google.com/maps?q=${mapa.dataset.lat},${mapa.dataset.lng}&z=16&output=embed`;
    iframe.title = 'Mapa com a localização da clínica';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    mapa.replaceChildren(iframe);
  });
</script>
