---
// Template do nicho pet: pet shop, clínica veterinária ou os dois (campo `tipo` do JSON).
// O que liga e desliga sozinho pelo JSON: faixa de emergência 24h, leva e traz, tabela de banho e tosa,
// equipe com CRMV, preços "a partir de" (só em serviço que não é ato veterinário, ver CFMV 1.649/2025).
import '@fontsource-variable/bricolage-grotesque/wght.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import IconePet, { type NomeIconePet } from '../components/pet/IconePet.astro';
import {
  type ClientePet,
  type CategoriaPet,
  imagem,
  linkWhatsapp,
  linkAvaliacoesGoogle,
  formatarNota,
  formatarPreco,
  DIAS,
  DIAS_SCHEMA,
} from '../lib/clientes';

interface Props {
  cliente: ClientePet;
}
const { cliente: c } = Astro.props;

const temVet = c.tipo !== 'petshop';
const temLoja = c.tipo !== 'veterinaria';
const endereco = c.endereco;
const nota = formatarNota(c.google.nota);
const heroImg = imagem(c, c.hero.imagem);
const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });

const whatsapp = linkWhatsapp(c);
const whatsappBanho = c.banhoETosa ? linkWhatsapp(c, c.banhoETosa.mensagemWhatsapp) : whatsapp;
const telLink = (t: string) => `tel:${t.replace(/[^\d+]/g, '')}`;
const telVisivel = (t: string) => t.replace('+55 ', '').replace(/^(\d\d) /, '($1) ');

// Uma ação principal, com o mesmo nome no hero, no topo e na barra fixa.
const cta = c.banhoETosa
  ? { texto: 'Agendar banho e tosa', curto: 'Agendar banho', link: whatsappBanho }
  : c.tipo === 'veterinaria'
    ? { texto: 'Agendar consulta', curto: 'Agendar consulta', link: whatsapp }
    : { texto: 'Chamar no WhatsApp', curto: 'Chamar no WhatsApp', link: whatsapp };

if (temVet && !c.responsavelTecnico) {
  console.warn(`[${c.slug}] Falta responsavelTecnico (nome e CRMV): a publicidade veterinária exige (CFMV 1.649/2025, art. 4º).`);
}

// Ato veterinário não leva preço no site (CFMV 1.649/2025, art. 6º, V). Preço só em estética, loja e hospedagem.
const CATEGORIAS_VET: CategoriaPet[] = ['clinica', 'vacinas', 'exames'];
const CATEGORIA: Record<CategoriaPet, { nome: string; icone: NomeIconePet }> = {
  clinica: { nome: 'Clínica veterinária', icone: 'estetoscopio' },
  vacinas: { nome: 'Vacinas', icone: 'seringa' },
  exames: { nome: 'Exames e cirurgias', icone: 'exame' },
  estetica: { nome: 'Banho e tosa', icone: 'tesoura' },
  loja: { nome: 'Loja e farmácia pet', icone: 'sacola' },
  hospedagem: { nome: 'Hospedagem e creche', icone: 'casa' },
};
const servicos = c.servicos.map((g) => {
  const vet = CATEGORIAS_VET.includes(g.categoria);
  if (vet && g.itens.some((i) => i.aPartirDe != null)) {
    console.warn(`[${c.slug}] Preço ignorado em "${g.categoria}": ato veterinário não leva preço no site.`);
  }
  return {
    ...CATEGORIA[g.categoria],
    nome: g.nome ?? CATEGORIA[g.categoria].nome,
    categoria: g.categoria,
    itens: g.itens.map((i) => ({ ...i, aPartirDe: vet ? undefined : i.aPartirDe })),
  };
});
const precos = [
  ...servicos.flatMap((g) => g.itens.map((i) => i.aPartirDe)),
  ...(c.banhoETosa?.portes.flatMap((p) => [p.banho, p.banhoETosa]) ?? []),
].filter((n): n is number => typeof n === 'number');
const temPreco = precos.length > 0;
const avisoPrecos =
  c.avisoPrecos ?? 'Preços a partir de. O valor final depende do porte, da pelagem e do comportamento do pet.';

// Selos do hero: o que é verdade pelo JSON + destaques livres.
const selos: { texto: string; icone: NomeIconePet }[] = [
  ...(c.emergencia24h ? [{ texto: 'Emergência 24h', icone: 'plantao' as const }] : []),
  ...(c.levaETraz ? [{ texto: 'Leva e traz', icone: 'carro' as const }] : []),
  ...(c.destaques ?? []).map((texto) => ({ texto, icone: 'pata' as const })),
];

// Cores do cliente. As superfícies claras saem da cor escura do cliente (ou de tema.claro).
const claro = c.tema?.claro;
const estiloTema = [
  c.tema?.grafite && `--grafite: ${c.tema.grafite}`,
  c.tema?.acento && `--acento: ${c.tema.acento}`,
  c.tema?.acentoTexto && `--acento-texto: ${c.tema.acentoTexto}`,
  `--color-marmore: ${claro ?? 'color-mix(in oklab, var(--color-grafite) 4%, #fff)'}`,
  `--color-pedra: color-mix(in oklab, var(--color-grafite) 9%, ${claro ?? '#fff'})`,
  `--color-pedra-escura: color-mix(in oklab, var(--color-grafite) 22%, #fff)`,
  `--font-display: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif`,
]
  .filter(Boolean)
  .join('; ');
const corTema = c.tema?.grafite ?? '#2e2c2f';
const favicon = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="${corTema}"/><g fill="${c.tema?.acento ?? '#b48a6a'}"><ellipse cx="16" cy="20" rx="6" ry="5"/><ellipse cx="8.5" cy="14" rx="2.2" ry="3"/><ellipse cx="13" cy="9.5" rx="2.2" ry="3"/><ellipse cx="19" cy="9.5" rx="2.2" ry="3"/><ellipse cx="23.5" cy="14" rx="2.2" ry="3"/></g></svg>`,
)}`;

const ordemDias = [1, 2, 3, 4, 5, 6, 0];
const horarioSemana = ordemDias.map((dia) => ({ dia, h: c.horario.find((x) => x.dia === dia) }));

// schema.org: PetStore é LocalBusiness; VeterinaryCare é MedicalOrganization (não herda LocalBusiness),
// por isso a veterinária sozinha leva também LocalBusiness. Sem aggregateRating: o Google não mostra estrelas
// de avaliação autoatribuída em LocalBusiness.
const tipoSchema =
  c.tipo === 'petshop' ? 'PetStore' : c.tipo === 'veterinaria' ? ['VeterinaryCare', 'LocalBusiness'] : ['PetStore', 'VeterinaryCare'];
const schema = {
  '@context': 'https://schema.org',
  '@type': tipoSchema,
  name: c.nome,
  description: c.descricao,
  url: new URL(`/${c.slug}`, Astro.site).toString(),
  image: new URL(og.src, Astro.site).toString(),
  telephone: c.contato.telefone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: endereco.rua,
    addressLocality: endereco.cidade,
    addressRegion: endereco.uf,
    postalCode: endereco.cep,
    addressCountry: 'BR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: endereco.lat, longitude: endereco.lng },
  hasMap: endereco.mapsUrl,
  areaServed: { '@type': 'City', name: endereco.cidade },
  priceRange: temPreco ? `${formatarPreco(Math.min(...precos))} a ${formatarPreco(Math.max(...precos))}` : undefined,
  openingHoursSpecification: c.horario.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${DIAS_SCHEMA[h.dia]}`,
    opens: h.abre,
    closes: h.fecha,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços',
    itemListElement: servicos.map((g) => ({
      '@type': 'OfferCatalog',
      name: g.nome,
      itemListElement: g.itens.map((i) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: i.nome },
        ...(i.aPartirDe != null && {
          priceSpecification: { '@type': 'PriceSpecification', minPrice: i.aPartirDe, priceCurrency: 'BRL' },
        }),
      })),
    })),
  },
  sameAs: c.contato.instagram ? [`https://www.instagram.com/${c.contato.instagram}/`] : undefined,
};

const tituloPagina = c.tipo === 'petshop'
  ? `${c.nome} | Pet shop no ${endereco.bairro}, ${endereco.cidade}`
  : c.tipo === 'veterinaria'
    ? `${c.nome} | Veterinário no ${endereco.bairro}, ${endereco.cidade}`
    : `${c.nome} | Pet shop e veterinário no ${endereco.bairro}, ${endereco.cidade}`;

// Título de seção do nicho: a Bricolage pede peso alto e espaçamento mais fechado que a Bodoni do odonto.
const tituloSecao = 'titulo-secao font-[750] tracking-[-0.025em]';
---

<Base
  titulo={tituloPagina}
  descricao={c.descricao}
  noindex={c.demo}
  imagemOg={og.src}
  estiloTema={estiloTema}
  schema={schema}
  fontePreload={bricolageLatin}
  corTema={corTema}
  favicon={favicon}
>
  <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-marmore focus:px-4 focus:py-2">
    Pular para o conteúdo
  </a>

  {c.emergencia24h && (
    <div class="bg-acento text-grafite">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-x-4 px-5 sm:px-8">
        <p class="flex items-center gap-2 py-2 text-[0.9375rem] font-semibold leading-tight">
          <IconePet nome="plantao" class="size-5 shrink-0" />
          <!-- No celular, uma linha só: o texto longo e o número aparecem do sm para cima. -->
          <span class="whitespace-nowrap sm:hidden">Emergência 24h</span>
          <span class="hidden sm:inline">{c.emergencia24h.texto ?? 'Emergência 24 horas'}</span>
        </p>
        <a href={telLink(c.emergencia24h.telefone)} class="inline-flex min-h-11 shrink-0 items-center gap-2 whitespace-nowrap font-bold">
          <Icone nome="telefone" class="hidden size-5 min-[375px]:block" />
          <span class="underline decoration-2 underline-offset-4">Ligar<span class="sm:hidden"> agora</span><span class="hidden sm:inline"> {telVisivel(c.emergencia24h.telefone)}</span></span>
        </a>
      </div>
    </div>
  )}

  <!-- Topo -->
  <header class="bg-grafite text-marmore">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
      <a href={`/${c.slug}`} class="-my-2 flex min-h-11 items-center gap-2.5 py-2 leading-none">
        <IconePet nome="pata" class="size-7 shrink-0 text-acento" />
        <span class="flex flex-col gap-1">
          <span class="font-display text-[1.375rem] font-[780] tracking-[-0.02em]">{c.nome}</span>
          {c.complemento && <span class="text-[0.8125rem] text-pedra-escura">{c.complemento}</span>}
        </span>
      </a>
      <a href={cta.link} class="btn btn-whatsapp hidden min-h-11 py-2 text-[0.9375rem] sm:inline-flex">
        <Icone nome="whatsapp" class="size-5" />
        {cta.texto}
      </a>
    </div>
  </header>

  <main id="conteudo">
    <!-- Hero -->
    <section class="bg-grafite text-marmore">
      <div class="mx-auto grid max-w-6xl gap-7 px-5 pb-12 pt-3 sm:gap-10 sm:px-8 sm:pb-14 md:grid-cols-[1.05fr_0.95fr] md:items-center md:gap-14 md:pb-20 md:pt-10">
        <div class="order-2 md:order-1">
          <h1 class="font-display text-[clamp(2.25rem,1.05rem+5.6vw,3rem)] font-[800] leading-[0.98] tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.5rem]">
            {c.hero.titulo}
          </h1>
          <p class="mt-5 max-w-[34rem] text-pedra sm:mt-6 sm:text-lg">{c.hero.subtitulo}</p>

          <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row md:flex-col md:items-start lg:flex-row">
            <a href={cta.link} class="btn btn-whatsapp hero-cta text-base">
              <Icone nome="whatsapp" class="size-5" />
              <!-- "pelo WhatsApp" só entre 375px e md: abaixo quebraria a linha, acima disputa espaço com o 2º botão. -->
              <span>{cta.texto}<span class="hidden min-[375px]:inline md:hidden"> pelo WhatsApp</span></span>
            </a>
            <a href="#servicos" class="btn btn-contorno text-base text-pedra hover:text-marmore">
              {temPreco ? 'Ver serviços e preços' : 'Ver serviços'}
            </a>
          </div>

          {selos.length > 0 && (
            <ul class="mt-7 flex flex-wrap gap-2" role="list" aria-label="Destaques">
              {selos.map((s) => (
                <li class="inline-flex items-center gap-1.5 rounded-full border border-white/20 py-1.5 pl-2.5 pr-3.5 text-[0.9375rem] text-pedra">
                  <IconePet nome={s.icone} class="size-[1.1rem] text-acento" />{s.texto}
                </li>
              ))}
              <li id="selo-hoje" class="inline-flex items-center gap-1.5 rounded-full border border-white/20 py-1.5 pl-2.5 pr-3.5 text-[0.9375rem] text-pedra" hidden>
                <Icone nome="relogio" class="size-[1.1rem] text-acento" /><span></span>
              </li>
            </ul>
          )}
        </div>

        <div class="relative order-1 md:order-2">
          <Image
            src={heroImg}
            alt={c.hero.imagemAlt}
            widths={[400, 640, 960]}
            quality={68}
            sizes="(min-width: 768px) 44vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/11] w-full rounded-[1.75rem] object-cover object-[50%_65%] sm:aspect-[16/10] md:aspect-[4/5] md:rounded-[2.5rem] md:object-center"
          />
          <!-- Medalha de coleira com a nota do Google: o elemento de assinatura do template. -->
          <a href={linkAvaliacoesGoogle(c)} class="medalha absolute bottom-3 left-3 md:-left-10 md:bottom-12">
            <span class="argola" aria-hidden="true"></span>
            <span class="placa">
              <span class="flex" aria-hidden="true">
                {[0, 1, 2, 3, 4].map(() => <Icone nome="estrela" class="size-3 sm:size-3.5" />)}
              </span>
              <span class="font-display text-[2.125rem] font-[800] leading-none tracking-[-0.04em] sm:text-[2.5rem]">
                <span class="sr-only">Nota </span>{nota}
              </span>
              <span class="text-center text-[0.75rem] font-semibold leading-tight sm:text-[0.8125rem]">
                {c.google.avaliacoes} avaliações<br />no Google
              </span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Serviços -->
    <section id="servicos" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="servicos-titulo">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <h2 id="servicos-titulo" class={tituloSecao}>{temPreco ? 'Serviços e preços' : 'Serviços'}</h2>
        {temPreco && <p class="max-w-sm text-[0.9375rem] text-tinta-suave">{avisoPrecos}</p>}
      </div>

      <div class="mt-10 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {servicos.map((g) => (
          <div>
            <h3 class="flex items-center gap-3 border-b-2 border-grafite pb-3 font-display text-[1.375rem] font-[720] tracking-[-0.015em]">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-acento text-grafite">
                <IconePet nome={g.icone} class="size-5" />
              </span>
              {g.nome}
            </h3>
            <dl class="divide-y divide-pedra-escura">
              {g.itens.map((item) => (
                <div class="grid grid-cols-[1fr_auto] gap-x-4 py-3.5">
                  <dt class="font-semibold">{item.nome}</dt>
                  {item.aPartirDe != null && (
                    <dd class="row-span-2 text-right leading-tight">
                      <span class="block text-[0.8125rem] text-tinta-suave">a partir de</span>
                      <span class="font-semibold tabular-nums">{formatarPreco(item.aPartirDe)}</span>
                    </dd>
                  )}
                  {item.texto && <dd class="col-start-1 mt-0.5 text-[0.9375rem] text-tinta-suave">{item.texto}</dd>}
                </div>
              ))}
            </dl>
            {g.categoria === 'estetica' && c.banhoETosa && (
              <a href="#banho-e-tosa" class="mt-1 inline-flex min-h-11 items-center font-semibold text-acento-texto underline decoration-1 underline-offset-4 hover:decoration-2">
                Ver preços por porte
              </a>
            )}
          </div>
        ))}
      </div>

      {temVet && (
        <p class="mt-10 max-w-2xl text-[0.9375rem] text-tinta-suave">
          Consultas, vacinas e exames dependem da avaliação do veterinário.{' '}
          <a href={whatsapp} class="font-semibold text-acento-texto underline decoration-1 underline-offset-4 hover:decoration-2">Pergunte pelo WhatsApp</a>.
        </p>
      )}
    </section>

    <!-- Banho e tosa -->
    {c.banhoETosa && (
      <section id="banho-e-tosa" class="bg-pedra" aria-labelledby="banho-titulo">
        <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24">
          <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-14">
            <div>
              <h2 id="banho-titulo" class={tituloSecao}>{c.banhoETosa.titulo ?? 'Banho e tosa'}</h2>
              <p class="mt-4 max-w-md text-tinta-suave">{c.banhoETosa.texto}</p>
              {c.banhoETosa.inclui && (
                <>
                  <h3 class="mt-8 font-semibold">Todo banho inclui</h3>
                  <ul class="mt-3 grid gap-2 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2" role="list">
                    {c.banhoETosa.inclui.map((item) => (
                      <li class="flex items-start gap-2"><IconePet nome="check" class="mt-1 size-5 shrink-0 text-acento-texto" />{item}</li>
                    ))}
                  </ul>
                </>
              )}
              {c.levaETraz && (
                <div class="mt-8 flex gap-4 rounded-[1.25rem] bg-grafite p-5 text-marmore">
                  <IconePet nome="carro" class="size-7 shrink-0 text-acento" />
                  <div>
                    <h3 class="font-semibold">Leva e traz</h3>
                    <p class="mt-1 text-[0.9375rem] text-pedra">
                      {c.levaETraz.texto}
                      {c.levaETraz.aPartirDe != null && <> Taxa a partir de {formatarPreco(c.levaETraz.aPartirDe)}.</>}
                    </p>
                  </div>
                </div>
              )}
            </div>

            <div class="self-start rounded-[1.5rem] bg-marmore p-5 sm:p-7">
              <table class="w-full text-left">
                <caption class="pb-4 text-left">
                  <span class="block font-display text-[1.375rem] font-[720] tracking-[-0.015em]">Preços por porte</span>
                  <span class="mt-1 block text-[0.9375rem] text-tinta-suave">{avisoPrecos}</span>
                </caption>
                <thead>
                  <tr class="border-b-2 border-grafite text-[0.875rem]">
                    <th scope="col" class="pb-2 pr-2 font-semibold">Porte</th>
                    <th scope="col" class="pb-2 pr-2 text-right font-semibold">Banho</th>
                    <th scope="col" class="pb-2 text-right font-semibold">Banho e tosa</th>
                  </tr>
                </thead>
                <tbody>
                  {c.banhoETosa.portes.map((p) => (
                    <tr class="border-b border-pedra-escura last:border-0">
                      <th scope="row" class="py-3.5 pr-2 font-normal">
                        <span class="block font-semibold">{p.porte}</span>
                        {p.peso && <span class="block text-[0.875rem] text-tinta-suave">{p.peso}</span>}
                      </th>
                      <td class="py-3.5 pr-2 text-right tabular-nums">{p.banho != null ? formatarPreco(p.banho) : '-'}</td>
                      <td class="py-3.5 text-right tabular-nums">{p.banhoETosa != null ? formatarPreco(p.banhoETosa) : '-'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          {c.banhoETosa.passos && (
            <>
              <h3 class="mt-16 font-display text-[1.75rem] font-[750] tracking-[-0.02em]">Como agendar</h3>
              <ol class="mt-6 grid gap-8 sm:grid-cols-3">
                {c.banhoETosa.passos.map((passo, i) => (
                  <li class="border-t-2 border-grafite/80 pt-4">
                    <span class="font-display text-4xl font-[800] text-acento-texto" aria-hidden="true">{i + 1}</span>
                    <h4 class="mt-2 text-lg font-semibold">{passo.titulo}</h4>
                    <p class="mt-1.5 text-tinta-suave">{passo.texto}</p>
                  </li>
                ))}
              </ol>
            </>
          )}
          <a href={whatsappBanho} class="btn btn-whatsapp mt-10 w-full text-base sm:w-auto">
            <Icone nome="whatsapp" class="size-5" />
            <span>Agendar banho e tosa<span class="hidden min-[375px]:inline"> pelo WhatsApp</span></span>
          </a>
        </div>
      </section>
    )}

    <!-- Equipe -->
    {c.equipe && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="equipe">
        <div class="max-w-2xl">
          <h2 id="equipe" class={tituloSecao}>{c.equipe.titulo ?? 'Equipe'}</h2>
          {c.equipe.texto && <p class="mt-4 text-tinta-suave">{c.equipe.texto}</p>}
        </div>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {c.equipe.pessoas.map((p) => (
            <li class="flex items-center gap-4">
              {p.foto ? (
                <Image src={imagem(c, p.foto)} alt="" widths={[96, 192]} sizes="96px" quality={68} class="size-24 shrink-0 rounded-full bg-pedra object-cover" />
              ) : (
                <span class="grid size-24 shrink-0 place-items-center rounded-full bg-pedra text-acento-texto" aria-hidden="true"><IconePet nome="pata" class="size-9" /></span>
              )}
              <div>
                <p class="font-semibold">{p.nome}</p>
                <p class="text-[0.9375rem] text-tinta-suave">{p.funcao}</p>
                {p.registro && <p class="mt-0.5 text-[0.875rem] font-semibold text-acento-texto">{p.registro}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Avaliações -->
    <section class="bg-grafite text-marmore" aria-labelledby="avaliacoes">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 id="avaliacoes" class={tituloSecao}>O que dizem os tutores</h2>
            <p class="mt-4 text-pedra">
              {c.google.cincoEstrelas
                ? `${c.google.cincoEstrelas} das ${c.google.avaliacoes} avaliações no Google são de 5 estrelas.`
                : `Nota ${nota} com ${c.google.avaliacoes} avaliações no Google.`}
            </p>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-display text-6xl font-[800] leading-none tracking-[-0.04em] text-acento">{nota}</span>
            <span class="flex text-acento" role="img" aria-label={`Nota ${nota} de 5`}>
              {[0, 1, 2, 3, 4].map(() => <Icone nome="estrela" class="size-5" />)}
            </span>
          </div>
        </div>

        <p class="mt-8 text-sm text-pedra-escura md:hidden">Deslize para o lado para ler mais avaliações.</p>
        <ul class="-mx-5 mt-4 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pb-4 sm:-mx-8 sm:scroll-px-8 sm:px-8 md:mx-0 md:mt-10 md:grid md:grid-cols-2 md:gap-6 lg:grid-cols-3 md:overflow-visible md:px-0 md:pb-0" role="list" tabindex="0" aria-label="Avaliações de tutores no Google">
          {c.avaliacoes.map((av) => (
            <li class="w-[85%] shrink-0 snap-start rounded-[1.25rem] bg-white/[0.07] p-6 sm:w-[60%] md:w-auto">
              <blockquote>
                <p class="text-pedra">“{av.texto}”</p>
                <footer class="mt-5 text-sm">
                  <span class="font-semibold text-marmore">{av.autor}</span>
                  <span class="text-pedra-escura">, no Google em {av.quando}</span>
                </footer>
              </blockquote>
            </li>
          ))}
        </ul>

        <a href={linkAvaliacoesGoogle(c)} class="btn btn-contorno mt-8 text-pedra hover:text-marmore">
          Ler todas as {c.google.avaliacoes} avaliações no Google
        </a>
      </div>
    </section>

    <!-- Espaço -->
    {c.espaco && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="espaco">
        <div class="max-w-2xl">
          <h2 id="espaco" class={tituloSecao}>{c.espaco.titulo}</h2>
          <p class="mt-4 text-tinta-suave">{c.espaco.texto}</p>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:grid-rows-2 md:gap-4">
          {c.espaco.fotos.map((foto, i) => (
            <Image
              src={imagem(c, foto.src)}
              alt={foto.alt}
              widths={[400, 700, 1000]}
              quality={68}
              sizes={i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
              class:list={[
                'h-full w-full rounded-[1.25rem] bg-pedra object-cover',
                i === 0 && 'col-span-2 aspect-[4/3] md:row-span-2 md:aspect-auto',
                (i === 1 || i === 2) && 'aspect-square',
                i >= 3 && 'col-span-2 aspect-[2/1]',
              ]}
            />
          ))}
        </div>
        {c.espaco.acessibilidade && (
          <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-tinta-suave" role="list">
            {c.espaco.acessibilidade.map((item) => (
              <li class="flex items-start gap-2"><Icone nome="acessivel" class="mt-[0.2rem] size-5 shrink-0 text-acento-texto" />{item}</li>
            ))}
          </ul>
        )}
      </section>
    )}

    <!-- Onde estamos -->
    <section id="onde" class="bg-pedra" aria-labelledby="onde-titulo">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-2 md:gap-14 md:py-24">
        <div>
          <h2 id="onde-titulo" class={tituloSecao}>Onde estamos</h2>
          <address class="mt-6 flex gap-3 not-italic">
            <Icone nome="pino" class="mt-1 size-5 shrink-0 text-acento-texto" />
            <span>
              {endereco.rua}<br />
              {endereco.bairro}, {endereco.cidade} - {endereco.uf}<br />
              CEP {endereco.cep}
            </span>
          </address>

          <h3 class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold">
            <Icone nome="relogio" class="size-5 text-acento-texto" />
            Horário de atendimento
            <span id="status-aberto" class="whitespace-nowrap rounded-full px-2.5 py-0.5 text-sm font-semibold" hidden></span>
          </h3>
          <table class="mt-4 w-full max-w-sm text-left">
            <caption class="sr-only">Horário de atendimento por dia da semana</caption>
            <tbody>
              {horarioSemana.map(({ dia, h }) => (
                <tr class="border-b border-pedra-escura" data-dia={dia}>
                  <th scope="row" class="py-2.5 font-normal">{DIAS[dia]}</th>
                  <td class="py-2.5 text-right tabular-nums">{h ? `${h.abre} às ${h.fecha}` : 'Fechado'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {c.emergencia24h && (
            <p class="mt-4 flex max-w-sm items-start gap-2 text-[0.9375rem]">
              <IconePet nome="plantao" class="mt-0.5 size-5 shrink-0 text-acento-texto" />
              <span>Fora desse horário, emergência 24h pelo <a href={telLink(c.emergencia24h.telefone)} class="font-semibold text-acento-texto underline decoration-1 underline-offset-4">{telVisivel(c.emergencia24h.telefone)}</a>.</span>
            </p>
          )}

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={cta.link} class="btn btn-whatsapp"><Icone nome="whatsapp" class="size-5" />{cta.texto}</a>
            <a href={endereco.mapsUrl} class="btn btn-contorno text-tinta">Abrir no Google Maps</a>
          </div>
        </div>

        <div class="mapa relative min-h-[20rem] overflow-hidden rounded-[1.5rem] bg-grafite text-marmore md:min-h-full" data-lat={endereco.lat} data-lng={endereco.lng}>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center">
            <Icone nome="pino" class="size-10 text-acento" />
            <p class="max-w-xs text-pedra">{endereco.rua}, no {endereco.bairro}, {endereco.cidade}.</p>
            <button type="button" class="mapa-botao btn btn-contorno min-h-11 cursor-pointer text-pedra hover:text-marmore">Mostrar mapa aqui</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-grafite pb-[calc(6.5rem+env(safe-area-inset-bottom))] text-pedra-escura sm:pb-28">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 pt-12 sm:px-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="font-display text-2xl font-[780] tracking-[-0.02em] text-acento">{c.nome}</p>
        <p class="mt-2 text-sm">{endereco.rua}, {endereco.bairro}, {endereco.cidade} - {endereco.uf}</p>
        {c.responsavelTecnico && (
          <p class="mt-2 text-sm">Responsável técnico: {c.responsavelTecnico.nome}, {c.responsavelTecnico.crmv}</p>
        )}
      </div>
      <ul class="-my-1 flex flex-col gap-1" role="list">
        <li><a href={whatsapp} class="inline-flex min-h-11 items-center gap-2.5 hover:text-marmore"><Icone nome="whatsapp" class="size-5" />{telVisivel(c.contato.telefone)}</a></li>
        {c.contato.instagram && (
          <li><a href={`https://www.instagram.com/${c.contato.instagram}/`} class="inline-flex min-h-11 items-center gap-2.5 hover:text-marmore"><Icone nome="instagram" class="size-5" />@{c.contato.instagram}</a></li>
        )}
      </ul>
    </div>
    {c.demo && (
      <p class="mx-auto mt-10 max-w-6xl px-5 text-[0.8125rem] leading-relaxed text-pedra-escura sm:px-8">
        Prévia de site criada para {c.nome}. Fotos, avaliações e informações públicas do Google e do Instagram {temLoja ? 'do pet shop' : 'da clínica'}.
      </p>
    )}
  </footer>

  <!--
    Barra fixa: aparece depois que o CTA do hero sai da tela. No celular ocupa a largura toda;
    com emergência 24h, ganha o botão de ligar ao lado. sm+: botões flutuantes no canto.
  -->
  <div
    id="whatsapp-fixo"
    data-oculto
    class="whatsapp-fixo fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-tinta/10 bg-marmore/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-sm sm:inset-x-auto sm:bottom-6 sm:right-6 sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none"
  >
    {c.emergencia24h && (
      <a
        href={telLink(c.emergencia24h.telefone)}
        aria-label="Ligar 24h para o plantão veterinário"
        class="btn min-h-12 shrink-0 bg-grafite px-4 text-base text-marmore sm:min-h-14 sm:px-5 sm:shadow-[0_8px_24px_rgb(0_0_0/0.25)]"
      >
        <IconePet nome="plantao" class="size-5 text-acento" />
        <span><span class="hidden min-[375px]:inline">Ligar </span>24h</span>
      </a>
    )}
    <a
      href={cta.link}
      class="btn btn-whatsapp min-h-12 flex-1 px-4 text-base sm:min-h-14 sm:flex-none sm:px-5 sm:shadow-[0_8px_24px_rgb(0_0_0/0.25)]"
    >
      <Icone nome="whatsapp" class="size-6" />
      <span class="sm:hidden">{cta.curto}</span>
      <span class="hidden sm:inline">WhatsApp</span>
    </a>
  </div>
</Base>

<style>
  /* Medalha de coleira: placa redonda com furo (máscara) e argola de metal passando por ele. */
  .medalha {
    display: block;
    width: 7.5rem;
    rotate: -7deg;
    transform-origin: 50% 0;
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.28));
    color: var(--color-grafite);
    transition: rotate 0.3s ease;
  }
  .medalha:hover { rotate: -2deg; }
  .medalha:focus-visible { outline-color: var(--color-acento); outline-offset: 6px; border-radius: 999px; }
  .placa {
    display: flex;
    aspect-ratio: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    padding-top: 1.1rem;
    border-radius: 999px;
    background: var(--color-acento);
    -webkit-mask: radial-gradient(circle at 50% 0.85rem, transparent 0.38rem, #000 0.42rem);
    mask: radial-gradient(circle at 50% 0.85rem, transparent 0.38rem, #000 0.42rem);
  }
  .argola {
    position: absolute;
    top: -0.85rem;
    left: 50%;
    width: 1.6rem;
    height: 1.6rem;
    translate: -50% 0;
    border: 3px solid var(--color-pedra-escura);
    border-radius: 999px;
  }
  @media (min-width: 40rem) {
    .medalha { width: 8.75rem; }
  }
</style>

<script>
  const agora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
  const linha = document.querySelector<HTMLTableRowElement>(`tr[data-dia="${agora.getDay()}"]`);
  if (linha) {
    linha.classList.add('font-semibold');
    const horas = linha.querySelector('td')?.textContent ?? '';
    const m = horas.match(/(\d\d):(\d\d) às (\d\d):(\d\d)/);
    const min = agora.getHours() * 60 + agora.getMinutes();
    const aberto = !!m && min >= +m[1] * 60 + +m[2] && min < +m[3] * 60 + +m[4];
    const status = document.getElementById('status-aberto');
    if (status) {
      status.textContent = aberto ? 'Aberto agora' : 'Fechado agora';
      // Verde cheio com texto branco (5,3:1). O verde sobre verde-claro do odonto dá 3,7:1 em cima do fundo pedra.
      status.className += aberto ? ' bg-whatsapp text-white' : ' bg-tinta/10 text-tinta';
      status.hidden = false;
    }
    // Selo do hero: o horário de hoje sem precisar rolar até o fim.
    const selo = document.getElementById('selo-hoje');
    const texto = selo?.querySelector('span');
    if (selo && texto) {
      texto.textContent = aberto && m ? `Aberto hoje até ${m[3]}:${m[4]}` : 'Fechado agora';
      selo.hidden = false;
    }
  }

  // Barra fixa aparece quando o CTA do hero fica para trás (mesma lógica do template de odontologia).
  const fixo = document.getElementById('whatsapp-fixo');
  const heroCta = document.querySelector('.hero-cta');
  if (fixo && heroCta) {
    let agendado = false;
    const atualizar = () => {
      agendado = false;
      fixo.toggleAttribute('data-oculto', heroCta.getBoundingClientRect().bottom > 0);
    };
    const pedir = () => {
      if (!agendado) { agendado = true; requestAnimationFrame(atualizar); }
    };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir, { passive: true });
    atualizar();
  } else {
    fixo?.removeAttribute('data-oculto');
  }

  // Mapa só carrega quando a pessoa pede.
  document.querySelector('.mapa-botao')?.addEventListener('click', () => {
    const mapa = document.querySelector<HTMLElement>('.mapa');
    if (!mapa) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.google.com/maps?q=${mapa.dataset.lat},${mapa.dataset.lng}&z=16&output=embed`;
    iframe.title = 'Mapa com a localização';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    mapa.replaceChildren(iframe);
  });
</script>
