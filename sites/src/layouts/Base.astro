---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import bodoniLatin from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';

interface Props {
  titulo: string;
  descricao: string;
  noindex?: boolean;
  imagemOg?: string;
  estiloTema?: string;
  schema?: Record<string, unknown>;
}

const { titulo, descricao, noindex = false, imagemOg, estiloTema, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR" style={estiloTema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#2e2c2f" />
    <link rel="preload" href={bodoniLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232e2c2f'/%3E%3Cpath d='M16 7c-3 0-4.6 1.2-6.4 1.2C7.4 8.2 6 9.8 6 12.6c0 3.4 1.6 5.4 2.4 8.6.6 2.6 1 4.8 2.4 4.8 1.6 0 1.8-2.6 2.6-4.8.4-1.2 1.2-1.8 2.6-1.8s2.2.6 2.6 1.8c.8 2.2 1 4.8 2.6 4.8 1.4 0 1.8-2.2 2.4-4.8.8-3.2 2.4-5.2 2.4-8.6 0-2.8-1.4-4.4-3.6-4.4C20.6 8.2 19 7 16 7z' fill='%23c9a486'/%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    {imagemOg && <meta property="og:image" content={new URL(imagemOg, Astro.site)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
