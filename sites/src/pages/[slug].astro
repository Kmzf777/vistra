---
import { listarClientes, type Cliente } from '../lib/clientes';
import Odontologia from '../templates/Odontologia.astro';
import Pet from '../templates/Pet.astro';

export function getStaticPaths() {
  return listarClientes().map((cliente) => ({ params: { slug: cliente.slug }, props: { cliente } }));
}

// O campo `nicho` do JSON escolhe o template.
const { cliente } = Astro.props as { cliente: Cliente };
---

{cliente.nicho === 'odontologia' && <Odontologia cliente={cliente} />}
{cliente.nicho === 'pet' && <Pet cliente={cliente} />}
